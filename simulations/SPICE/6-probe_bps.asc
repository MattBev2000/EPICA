TEXT -200 -240 Left 2 !.param mi = 1.0360364770643182e-8
TEXT -200 -200 Left 2 !.param n = 1e17
TEXT -200 -80 Left 2 !.param Jsat_e = q * Ap * n * sqrt(Kb * T / (2 * pi * me))
TEXT -200 -40 Left 2 !.param Jsat_i = q * Ap * n * sqrt(Kb * T / (2 * pi * mi))
TEXT -200 -480 Left 2 ;DATA -------------------------------------------------------------------------------
TEXT 808 -344 Left 2 !.func phi_ne(x) {(x - Vs) / (T * Kb)}
TEXT -200 -440 Left 2 !.param q = 1.62e-19
TEXT 808 -304 Left 2 !.func phi_ni(x) {-(x - Vs) / (T * Kb)}
TEXT -200 -400 Left 2 !.param Kb = 8.61e-5
TEXT 808 -184 Left 2 !.func Iprobe(x) {Jsat_e*F(phi_ne(x)) - Jsat_i*F(phi_ni(x))}
