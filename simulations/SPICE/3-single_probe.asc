TEXT -1400 1704 Left 2 !.param me = 5.685e-12
TEXT -1400 1744 Left 2 !.param mi = 1.0360364770643182e-8
TEXT -1400 1784 Left 2 !.param n =  1e16
TEXT -1400 1944 Left 2 !.param Jsat_e = q * Ap * n * sqrt(Kb * T / (2 * pi * me))
TEXT -1400 1984 Left 2 !.param Jsat_i = q * Ap * n * sqrt(Kb * T / (2 * pi * mi))
TEXT -1400 1504 Left 2 ;DATA -------------------------------------------------------
TEXT -648 1640 Left 2 !.func phi_ne(x) {(x - Vs) / (T * Kb)}
TEXT -1400 1864 Left 2 !.step param Vb -120 120 0.5
TEXT -1400 1544 Left 2 !.param q = 1.62e-19
TEXT -648 1680 Left 2 !.func phi_ni(x) {-(x - Vs) / (T * Kb)}
TEXT -1400 1584 Left 2 !.param Kb = 8.61e-5
TEXT -648 1800 Left 2 !.func Iprobe(x) {Jsat_e*F(phi_ne(x)) - Jsat_i*F(phi_ni(x))}
