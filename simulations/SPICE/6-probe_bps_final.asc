TEXT 808 -224 Left 2 !.func F(phi) {if(phi <= 0, exp(phi), {epsilon}*erf(phi_t(phi)) + exp(phi)*erfc({epsilon}*phi_t(phi)))}
TEXT 808 -424 Left 2 !.func erf(x) {tanh((167/148) * x + (11/109) * pwr(x, 3))}
TEXT 808 -480 Left 2 ;FUNTION --------------------------------------------------------------------------------------------------------------
TEXT 808 -384 Left 2 !.func erfc(x) {1 - erf(x)}
TEXT 808 -264 Left 2 !.func phi_t(x) {if(x <= 0, 0, sqrt(x / (pwr({epsilon}, 2) - 1)))}
TEXT -200 -120 Left 2 !.param T = (17406.8 * 3)
TEXT -200 -160 Left 2 !.param Vs = 5 * T * Kb
TEXT -200 -360 Left 2 !.param Ap = 5e-6
TEXT -200 -320 Left 2 !.param epsilon = 5
TEXT -200 -280 Left 2 !.param me = 5.685e-12
TEXT -200 -240 Left 2 !.param mi = 1.0360364770643182e-8
TEXT -200 -200 Left 2 !.param n = 1e17
TEXT -200 -80 Left 2 !.param Jsat_e = q * Ap * n * sqrt(Kb * T / (2 * pi * me))
TEXT -200 -40 Left 2 !.param Jsat_i = q * Ap * n * sqrt(Kb * T / (2 * pi * mi))
TEXT -200 -480 Left 2 ;DATA -------------------------------------------------------------------------------
TEXT 808 -344 Left 2 !.func phi_ne(x) {(x - Vs) / (T * Kb)}
TEXT -200 -440 Left 2 !.param q = 1.62e-19
TEXT 808 -304 Left 2 !.func phi_ni(x) {-(x - Vs) / (T * Kb)}
TEXT -200 -400 Left 2 !.param Kb = 8.61e-5
TEXT 808 -184 Left 2 !.func Iprobe(x) {Jsat_e*F(phi_ne(x)) - Jsat_i*F(phi_ni(x))}
